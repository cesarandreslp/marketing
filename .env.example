# Solo configuración de la INSTALACIÓN. Lo de cada usuario (API keys, redes,
# fechas, territorio) se ingresa en la app: Configuración, cifrado por cuenta.
# instalar.ps1 copia este archivo a .env y genera las claves vacías.

POSTGRES_PASSWORD=
DATABASE_URL=postgresql://radar:${POSTGRES_PASSWORD}@127.0.0.1:5433/radar
N8N_ENCRYPTION_KEY=
# Cifra las claves de los usuarios en la base (64 hex). Si se pierde, hay que volver a ingresarlas.
APP_MASTER_KEY=
# Firma las sesiones. Cambiarlo cierra todas las sesiones.
SESSION_SECRET=

# 1 = cualquiera puede crear cuenta en /bienvenida (para vender como servicio).
# Vacío = solo se puede crear la primera cuenta.
REGISTRO_ABIERTO=
# 1 cuando la app se sirva por https (cookies seguras).
APP_HTTPS=
# Postiz (publicación en redes, http://localhost:4007). Las claves se generan solas.
POSTIZ_JWT_SECRET=
POSTIZ_DB_PASSWORD=
TEMPORAL_DB_PASSWORD=
# true después de crear tu usuario en Postiz (nadie más podrá registrarse).
POSTIZ_SIN_REGISTRO=
# Apps de desarrollador de cada red para Postiz (ver README → Postiz).
POSTIZ_FACEBOOK_APP_ID=
POSTIZ_FACEBOOK_APP_SECRET=
POSTIZ_TIKTOK_CLIENT_ID=
POSTIZ_TIKTOK_CLIENT_SECRET=
POSTIZ_X_API_KEY=
POSTIZ_X_API_SECRET=
POSTIZ_YOUTUBE_CLIENT_ID=
POSTIZ_YOUTUBE_CLIENT_SECRET=
# Almacenamiento público para fotos/videos (necesario para Instagram y TikTok).
# Vacío = local. Para Cloudflare R2: POSTIZ_STORAGE=cloudflare y los datos del bucket.
POSTIZ_STORAGE=
POSTIZ_R2_ACCOUNT_ID=
POSTIZ_R2_ACCESS_KEY=
POSTIZ_R2_SECRET_KEY=
POSTIZ_R2_BUCKET=
POSTIZ_R2_PUBLIC_URL=

# URL de n8n para la API (la app instala flujos). La pantalla Automatizaciones usa N8N_MARCO_URL (por defecto http://localhost:5679, el intermediario).
N8N_URL=http://localhost:5678
# URL de la app vista desde n8n. Cámbiala si n8n corre en otro equipo.
APP_URL=http://host.docker.internal:3000
